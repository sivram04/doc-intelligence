# Extractor providers for the model race. All free tiers; leave blank to skip.
GEMINI_API_KEY=
GROQ_API_KEY=
# Project 1 gateway (OpenAI-compatible): routes to the above with caching + budgets.
GATEWAY_URL=http://localhost:8000/v1
GATEWAY_API_KEY=
# Local GGUF models (zero-shot + fine-tuned) via Ollama.
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=postgresql://docintel:docintel@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
# Free-tier pacing (requests per minute); raise on paid tiers.
GEMINI_RPM=12
GROQ_RPM=25

# Which model reads documents. Default for `docintel`: ollama:docintel-qwen1.5b-ft-v5
# EXTRACTOR=ollama:docintel-qwen1.5b-ft-v5
# EXTRACTOR=cascade:ollama:docintel-qwen1.5b-ft-v5|gemini:gemini-3.5-flash-lite

# Public demo only (leave unset when running on your own computer)
# DEMO_MODE=1
# DEMO_MAX_DOCS=2
# DEMO_MAX_PAGES=3
# DEMO_DAILY_CAP=150
# DEMO_TTL_HOURS=24
# DEMO_SALT=change-me
# TRUST_CLOUDFLARE=1   # only when every request reaches the app through Cloudflare (uses CF-Connecting-IP)
# REPO_URL=https://github.com/sivram04/doc-intelligence

# Long documents (Reports tab). Default: Gemini when GEMINI_API_KEY is set, else local qwen2.5:1.5b.
# SUMMARY_MODEL=ollama:qwen2.5:1.5b
# MAX_LONGDOC_PAGES=500
# Public demo: DEMO_LONGDOC_PAGES=15, DEMO_MAX_QUESTIONS=10
